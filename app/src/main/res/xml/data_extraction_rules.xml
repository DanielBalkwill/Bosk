<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ backup/transfer rules. Exclude the encrypted API-key prefs from both
     cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mnemos_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mnemos_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
