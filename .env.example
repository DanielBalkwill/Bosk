# Mnemos — environment / secrets template.
#
# Android Gradle reads secrets from `local.properties` (gitignored), NOT from a .env at
# runtime. This file documents what you need. Copy the relevant lines into local.properties.
#
# 1) Android SDK location (Android Studio writes this automatically):
# sdk.dir=/home/<you>/Android/Sdk
#
# 2) Google OAuth *Web application* client ID — used as the server client id for
#    Google Sign-In via Credential Manager (CP5). Create at:
#    https://console.cloud.google.com/  → Credentials → OAuth client ID → Web application
# GOOGLE_SERVER_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
#
# NOTE: The user's *Gemini API key* is NOT stored here. It is entered in-app at runtime
# and kept in EncryptedSharedPreferences (BYOK, on-device only). See core/auth/SecureKeyStore.kt.
